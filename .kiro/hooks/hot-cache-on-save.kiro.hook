{
  "enabled": true,
  "name": "Update Wiki Hot Cache",
  "description": "When wiki pages are modified, update wiki/hot.md with a brief summary of what changed to maintain session continuity.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "wiki/**/*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A wiki page was just saved. Apply these guards in order before doing anything: (1) If the only file that changed is wiki/hot.md itself, do nothing and stop (prevents an infinite loop). (2) If the file .vault-meta/batch-in-progress exists, do nothing and stop (a batch ingest or lint is running and will refresh the hot cache once at the end). (3) Debounce: check the modification time of wiki/hot.md (e.g. `stat -c %Y wiki/hot.md` on Linux or `stat -f %m wiki/hot.md` on macOS); if it was modified less than 5 seconds ago, do nothing and stop. Otherwise, silently read wiki/hot.md, then update it with a brief summary of the recent change. The hot cache format is: Last Updated, Key Recent Facts, Recent Changes, Active Threads. Keep it under 500 words. Overwrite the file completely - it is a cache, not a journal. Do not announce this update to the user unless they ask about it."
  }
}
