{
  "title": "Clear Stale Wiki Locks",
  "description": "On prompt submit, clear any advisory locks older than 1 hour to prevent deadlocks from crashed sessions.",
  "event": "prompt_submit",
  "action": "shell_command",
  "command": "cd \"$PROJECT_ROOT\" && [ -x scripts/wiki-lock.sh ] && bash scripts/wiki-lock.sh clear-stale --max-age 3600 >/dev/null 2>&1 || true"
}
