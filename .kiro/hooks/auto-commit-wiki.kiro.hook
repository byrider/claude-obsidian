{
  "enabled": true,
  "name": "Auto-commit Wiki Changes",
  "description": "After wiki files are saved, stage and commit them to git, but ONLY when the host-specific opt-in sentinel .vault-meta/auto-commit.enabled exists and no advisory locks are held. Off by default everywhere (including Web sandboxes). Never auto-commits .raw/ sources, so secrets dropped into .raw/ are not committed without review.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "wiki/**/*"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd \"$PROJECT_ROOT\" && [ -d .git ] || exit 0; [ -f .vault-meta/auto-commit.enabled ] || exit 0; [ -f .vault-meta/auto-commit.disabled ] && exit 0; if [ -x scripts/wiki-lock.sh ]; then LOCK_LIST=$(bash scripts/wiki-lock.sh list 2>/dev/null); if [ -n \"$LOCK_LIST\" ]; then exit 0; fi; fi; sleep 2; git add -- wiki/ .vault-meta/ 2>/dev/null && (git diff --cached --quiet -- wiki/ .vault-meta/ || git commit -m \"wiki: auto-commit $(date '+%Y-%m-%d %H:%M')\" -- wiki/ .vault-meta/ 2>/dev/null) || true"
  }
}
