{
  "enabled": true,
  "name": "Auto-commit Wiki Changes",
  "description": "After wiki files are saved, automatically stage and commit changes to git if no advisory locks are currently held.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "wiki/**/*",
      ".raw/**/*"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd \"$PROJECT_ROOT\" && [ -d .git ] || exit 0; [ -f .vault-meta/auto-commit.disabled ] && exit 0; if [ -x scripts/wiki-lock.sh ]; then LOCK_LIST=$(bash scripts/wiki-lock.sh list 2>/dev/null); if [ -n \"$LOCK_LIST\" ]; then exit 0; fi; fi; sleep 2; git add -- wiki/ .raw/ .vault-meta/ 2>/dev/null && (git diff --cached --quiet -- wiki/ .raw/ .vault-meta/ || git commit -m \"wiki: auto-commit $(date '+%Y-%m-%d %H:%M')\" -- wiki/ .raw/ .vault-meta/ 2>/dev/null) || true"
  }
}
