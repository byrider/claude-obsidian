{
  "enabled": true,
  "name": "Load Wiki Hot Cache on Prompt",
  "description": "On prompt submit, load wiki/hot.md to provide recent context for continuity across sessions.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "[ -f wiki/hot.md ] && cat wiki/hot.md || true"
  }
}
